import { ArkUIViewController, InternalArkUIViewController } from 'libcompose_arkui_utils.so';
import { ComposeSizeProxy } from './ComposeSizeProxy';
import { MessengerImpl } from './messenger/Messenger';
import { TextToolbar, TextToolbarOverlay, TextToolbarParams } from './texttoolbar/TextToolbar';
import { ClipboardProxy } from './clipboard/ClipboardProxy';
import { common } from '@kit.AbilityKit';
import { KeyboardManager } from './keyboard/KeyboardManager';
import { BackHandler } from './backhandler/BackHandler';
import { DensityManager } from './density/DensityManager';
import { ComponentLifecycleImpl } from './lifecycle/ComponentLifecycle';
import { WindowStageManager } from './window/WindowStageManager';
import { ScreenChangeCallback, ScreenRotationManager } from './ScreenRotationManager';
import { OnAxisEventCompatModifier } from './Compat';
import { ComposeNodeController, RenderFrameManager } from './ComposeNode';
import { NodeContent, uiObserver } from '@kit.ArkUI';
import { deviceInfo } from '@kit.BasicServicesKit';
import { displaySync } from '@kit.ArkGraphics2D';

let GeneratedIndex = 0;

function autoGeneratedComposeId(): string {
  return `Compose_${GeneratedIndex++}`
}

// RenderNode CAPI was introduced in version 6.0.0.45, with bug fixes in version 6.0.0.107.
const capiRenderNodeSupported: boolean = (deviceInfo.distributionOSApiVersion > 60000 ||
  (deviceInfo.distributionOSApiVersion == 60000 && deviceInfo.buildVersion >= 45));

@Component
export struct ComposeArkUIBacked {
  public componentId: string = autoGeneratedComposeId()
  @Require public controller: ArkUIViewController | undefined = undefined
  @Require public libraryName: string | undefined = undefined
  public onBackPressed: (() => boolean) | undefined

  private rootContent = new NodeContent()
  private frameMgr: RenderFrameManager = new RenderFrameManager(this.getUIContext(), displaySync.create())
  private enableCApi: boolean = capiRenderNodeSupported

  private composeNodeController: ComposeNodeController | null = null
  @Prop private bgColor: string | undefined = undefined
  private refreshId: number | undefined = undefined
  private screenChangeManager = ScreenRotationManager.getInstance()
  private messenger: MessengerImpl = new MessengerImpl();
  private lifecycle: ComponentLifecycleImpl = new ComponentLifecycleImpl()
  private textToolbar: TextToolbar | null = null
  private clipboardProxy: ClipboardProxy | null = null
  private keyboardManager: KeyboardManager | null = null
  private backHandler: BackHandler | null = null
  private composeSizeProxy: ComposeSizeProxy | null = null
  private densityMessenger: DensityManager | null = null
  private windowStateManager: WindowStageManager | null = null
  @State private textToolbarParams: TextToolbarParams = new TextToolbarParams()
  /** 是否激活 Surface；激活时创建 XComponent 渲染画面，占用内存；非激活时销毁 XComponent 释放内存 */
  @Prop public isSurfaceActive: boolean = true
  private screenChangeCallback: ScreenChangeCallback = {
    onScreenChangeStart: (): void => {
      this.refreshId && this.requireController().cancelSyncRefresh(this.refreshId)
      this.refreshId = this.requireController().requestSyncRefresh()
    },
    onScreenChangeEnd: (): void => {
      this.refreshId && this.requireController().cancelSyncRefresh(this.refreshId)
      this.refreshId = undefined
    }
  }
  private onAxisEventCompat: OnAxisEventCompatModifier<StackAttribute> = new OnAxisEventCompatModifier(e => {
    this.requireController().onAxisEvent(e)
  })

  private densityUpdateCallback: ((info: uiObserver.DensityInfo) => void) | null = null

  aboutToAppear(): void {
    this.requireController().init(this.componentId, null, null, null)
    this.initMessenger()
    this.requireController().initContext(getContext())
    this.requireController().initUIContext(this.getUIContext())
    this.requireController().initRenderContext(this.enableCApi, this.frameMgr, this.rootContent)
    this.requireController().aboutToAppear()
    this.screenChangeManager.registerScreenChange(this.screenChangeCallback)
    this.keyboardManager = new KeyboardManager(this.getUIAbilityContext(), this.requireController())
    this.keyboardManager.aboutToAppear()
    this.lifecycle.aboutToAppear()
    this.composeNodeController = new ComposeNodeController(this.enableCApi, this.rootContent)
    this.composeNodeController.setController(this.requireController())
    this.frameMgr?.setCallbackController(this.requireController())
    this.registerDensityUpdate()
  }

  private registerDensityUpdate(): void {
    const callback = (info: uiObserver.DensityInfo): void => {
      this.requireController().updateDensity(info.density)
    }
    this.densityUpdateCallback = callback
    this.getUIContext().getUIObserver().on('densityUpdate', callback)
  }

  private unregisterDensityUpdate(): void {
    if (this.densityUpdateCallback !== null) {
      this.getUIContext().getUIObserver().off('densityUpdate', this.densityUpdateCallback)
      this.densityUpdateCallback = null
    }
  }

  aboutToDisappear(): void {
    this.frameMgr?.onDispose()
    this.requireController().aboutToDisappear()
    this.composeSizeProxy?.unregisterSizeChange()
    this.screenChangeManager.unregisterScreenChange(this.screenChangeCallback)
    this.keyboardManager?.aboutToDisappear()
    this.lifecycle.aboutToDisappear()
    this.composeNodeController?.onDestroy();
    this.requireController().onSurfaceDestroyed()
    this.unregisterDensityUpdate()
  }

  initMessenger() {
    this.requireController().initMessenger(this.messenger)
    this.messenger.controller = this.requireController()
    this.textToolbar = new TextToolbar(
      this.messenger,
      (params) => {
        this.textToolbarParams.update(params)
      },
      () => {
        this.textToolbarParams.reset()
      })
    this.clipboardProxy = new ClipboardProxy(this.messenger)
    this.backHandler = new BackHandler(this.messenger, () => this.onBackPressed?.() ?? false)
    this.composeSizeProxy = new ComposeSizeProxy(this.messenger)
    this.densityMessenger = new DensityManager(this.messenger)
    this.windowStateManager = new WindowStageManager(this.getUIAbilityContext().windowStage, this.messenger, this.lifecycle)
  }

  build() {
    Stack() {
      // there are five layers in stack, consisting of one compose layer and three interop layers.
      // the stack, touchable interop container can receive touch event.
      Stack() {
        // TODO(待优化): 临时处理compose onKeyEvent 依赖焦点问题
        // Request focus to receive key event for compose.
        Button("Focus").opacity(0).defaultFocus(true)
        NodeContainer(this.composeNodeController)
          .width("100%")
          .height("100%")
          .backgroundColor(Color.Transparent)
      }.backgroundColor(this.bgColor)
      .onTouch(e => {
        // Just dispatch to compose.\
        this.requireController().dispatchTouchEvent(e, true)
      })
      TextToolbarOverlay({ params: this.textToolbarParams })
        .width("100%")
        .height("100%")
        .hitTestBehavior(HitTestMode.Transparent)
    }
  }

  private requireController(): InternalArkUIViewController {
    if (this.controller === undefined) {
      throw new Error("controller is undefined")
    } else {
      return this.controller as InternalArkUIViewController;
    }
  }

  private requireLibraryName(): string {
    if (this.libraryName === undefined) {
      throw new Error("controller is undefined")
    } else {
      return this.libraryName;
    }
  }

  private getUIAbilityContext(): common.UIAbilityContext {
    return getContext() as common.UIAbilityContext
  }
}

class TouchPadPinchDetector implements GestureModifier {
  callback: Callback<GestureEvent>

  constructor(callback: Callback<GestureEvent>) {
    this.callback = callback
  }

  applyGesture(event: UIGestureEvent): void {
    let lastScale = 1
    event.addGesture(
      new PinchGestureHandler()
        .onActionStart(_ => {
          lastScale = 1
        })
        .onActionUpdate(e => {
          if (e.source == SourceType.Mouse) {
            const curScale = e.scale
            e.scale = curScale / lastScale
            this.callback(e)
            e.scale = curScale
            lastScale = curScale
          }
        })
        .onActionEnd(_ => {
          lastScale = 1
        })
        .onActionCancel(_ => {
          lastScale = 1
        })
    )
  }
}